# Configuration AFERTES Connect pour YunoHost
# Généré automatiquement lors de l'installation

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=__DB_NAME__
DB_USER=__DB_USER__
DB_PASSWORD=__DB_PWD__

# JWT
JWT_SECRET=__JWT_SECRET__

# Serveur
PORT=__PORT__
NODE_ENV=production
APP_URL=https://__DOMAIN____PATH__

# Email (optionnel - configurer pour l'envoi réel)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_FROM="AFERTES Connect" <noreply@example.com>
